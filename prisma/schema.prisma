// Aurene auction platform schema.
//
// Design notes:
//   * `Auction.currentBidId` is a denormalized pointer to the highest bid for
//     fast list-page reads. It is kept in sync inside the bid placement
//     transaction.
//   * `AuctionSettlement` is the source of truth for the fallback bidder chain.
//     It points to the bid currently obligated to pay; on timeout we forfeit
//     it and promote the next one.
//   * Money uses `Decimal(12, 2)` everywhere — never floats.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum AuctionStatus {
  DRAFT
  UPCOMING
  LIVE
  ENDED
  PAYMENT_PENDING
  SOLD
  EXPIRED
  CANCELLED
}

enum AuctionCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
}

enum BidStatus {
  ACTIVE
  OUTBID
  WON
  FORFEITED
  REFUNDED
}

enum SettlementStatus {
  AWAITING_PAYMENT
  ESCROW_HOLD          // Paid by buyer, waiting for seller to ship
  DELIVERED_PENDING    // Marked delivered, 48-hour inspection clock running
  DISPUTED             // Buyer raised a dispute with proof
  COMPLETED            // Approved/auto-released: 90% seller, 10% platform
  REFUNDED             // Admin approved refund to buyer
  EXHAUSTED            // Bidder chain timed out without payment
}

enum NotificationType {
  AUCTION_LIVE
  AUCTION_ENDING
  OUTBID
  AUCTION_ENDED
  WON
  PAYMENT_DUE
  WINNER_FORFEITED
  AUCTION_EXPIRED
  AUCTION_SOLD
  NEW_INQUIRY
  INQUIRY_ANSWERED
  ESCROW_SECURED      // Buyer paid → seller notified to ship
  ITEM_SHIPPED        // Seller shipped → buyer notified
  ITEM_DELIVERED      // Buyer/seller confirmed delivery → inspection clock starts
  FUNDS_RELEASED      // Inspection passed → seller wallet credited
  DISPUTE_OPENED      // Buyer raised dispute → admin + seller notified
  DISPUTE_RESOLVED    // Admin resolved dispute → both parties notified
  SHIPPING_DEADLINE   // Seller hasn't shipped in time → auto-refund warning
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  avatarUrl     String?
  role          Role     @default(USER)
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  auctions       Auction[]       @relation("SellerAuctions")
  bids           Bid[]
  watchlist      Watchlist[]
  notifications  Notification[]
  refreshTokens  RefreshToken[]
  bankAccount    BankAccount?
  wallet         Wallet?
  withdrawals    Withdrawal[]
  phoneOtps      PhoneOtp[]
  emailOtps      EmailOtp[]
  reports        AuctionReport[] @relation("UserReports")
  inquiriesAsked AuctionInquiry[]
  walletDepositOrders WalletDepositOrder[]
  disputes       SettlementDispute[]

  @@index([email])
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  deviceInfo String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Auction {
  id           String           @id @default(cuid())
  sellerId     String
  title        String
  description  String
  category     String
  brand        String
  condition    AuctionCondition
  size         String
  basePrice    Decimal          @db.Decimal(12, 2)
  minIncrement Decimal          @db.Decimal(12, 2)
  buyNowPrice  Decimal?         @db.Decimal(12, 2)
  startsAt     DateTime
  endsAt       DateTime
  status       AuctionStatus    @default(DRAFT)
  tags         String[]
  viewCount    Int              @default(0)
  bidCount     Int              @default(0)
  currentBidId String?          @unique
  soldAt       DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  seller     User               @relation("SellerAuctions", fields: [sellerId], references: [id])
  images     AuctionImage[]
  bids       Bid[]              @relation("AuctionBids")
  currentBid Bid?               @relation("CurrentBid", fields: [currentBidId], references: [id], onDelete: SetNull)
  settlement AuctionSettlement?
  watchlist  Watchlist[]
  reports    AuctionReport[]
  inquiries  AuctionInquiry[]

  @@index([status, endsAt])
  @@index([category, status])
  @@index([sellerId])
  @@index([startsAt])
}

model AuctionImage {
  id        String  @id @default(cuid())
  auctionId String
  url       String
  sortOrder Int     @default(0)
  isCover   Boolean @default(false)

  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  @@index([auctionId])
}

model Bid {
  id        String    @id @default(cuid())
  auctionId String
  bidderId  String
  amount    Decimal   @db.Decimal(12, 2)
  status    BidStatus @default(ACTIVE)
  ipAddress String?   // Logged for shill-bid detection
  placedAt  DateTime  @default(now())

  auction Auction @relation("AuctionBids", fields: [auctionId], references: [id], onDelete: Cascade)
  bidder  User    @relation(fields: [bidderId], references: [id])

  // Reverse relations required by Prisma — these are 0..1 because the FKs are
  // unique on the other side. They are not addressed in app code directly.
  currentBidForAuction Auction?           @relation("CurrentBid")
  winnerOfSettlement   AuctionSettlement? @relation("SettlementWinner")

  @@index([auctionId, amount(sort: Desc)])
  @@index([bidderId])
  @@index([status])
  @@index([ipAddress])
}

model AuctionSettlement {
  id                 String           @id @default(cuid())
  auctionId          String           @unique
  currentWinnerBidId String?          @unique
  paymentDeadline    DateTime
  attemptCount       Int              @default(1)
  status             SettlementStatus @default(AWAITING_PAYMENT)
  // Delivery tracking
  shippedAt          DateTime?
  trackingNumber     String?
  courierName        String?
  deliveredAt        DateTime?
  inspectionDeadline DateTime?        // deliveredAt + INSPECTION_WINDOW_HOURS
  shippingDeadline   DateTime?        // escrowHoldAt + 5 days; auto-refund if exceeded
  releasedAt         DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  auction          Auction            @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  currentWinnerBid Bid?               @relation("SettlementWinner", fields: [currentWinnerBidId], references: [id], onDelete: SetNull)
  transactions     Transaction[]
  dispute          SettlementDispute?

  @@index([status])
  @@index([paymentDeadline])
  @@index([inspectionDeadline])
  @@index([shippingDeadline])
}

model Watchlist {
  userId    String
  auctionId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  @@id([userId, auctionId])
  @@index([userId])
  @@index([auctionId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  payload   Json
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
}

model Transaction {
  id               String            @id @default(cuid())
  settlementId     String
  amount           Decimal           @db.Decimal(12, 2)
  commissionAmount Decimal?          @db.Decimal(12, 2) // platform fee taken from this sale
  status           TransactionStatus @default(PENDING)
  provider         String            @default("MOCK")
  externalRef      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  settlement AuctionSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@index([settlementId])
}

// ── Wallet / Bank / Payouts ──────────────────────────────────────────────
// Every participant has ONE bank account (replaceable) and ONE wallet. Sellers'
// net proceeds (sale minus platform commission) are credited to their wallet on
// SOLD; buyers' refunds land in their wallet too. Funds are withdrawn to the
// linked bank account. Required to bid OR sell (payment-ready + anti-fraud).

enum BankAccountStatus {
  PENDING
  VERIFIED
}

enum PayoutMethodType {
  BANK
  UPI
}

// A user's single payout method — either a BANK account (number + IFSC) or a
// UPI handle linked to a phone number that was verified via OTP.
model BankAccount {
  id                 String            @id @default(cuid())
  userId             String            @unique
  type               PayoutMethodType  @default(BANK)
  accountHolderName  String
  // Bank fields (type = BANK only). Number stored encrypted; only last4 exposed.
  accountNumberLast4 String?
  accountNumberEnc   String?
  ifsc               String?
  bankName           String?
  // UPI/phone fields (type = UPI only).
  upiId              String?
  phone              String?
  phoneVerifiedAt    DateTime?
  status             BankAccountStatus @default(VERIFIED)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Short-lived phone OTP codes (hashed). Used to verify a UPI/phone payout method.
model PhoneOtp {
  id         String    @id @default(cuid())
  userId     String
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, phone, createdAt(sort: Desc)])
}

// Short-lived email OTP codes (hashed). Used to verify a user's email address on signup.
model EmailOtp {
  id         String    @id @default(cuid())
  userId     String
  email      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, email, createdAt(sort: Desc)])
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  currency  String   @default("INR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

enum WalletTxnType {
  SALE_CREDIT
  WITHDRAWAL_DEBIT
  REFUND_CREDIT
  ADJUSTMENT
  DEPOSIT_CREDIT
  PLATFORM_PROFIT_CREDIT  // 10% commission credited to platform owner wallet
}

model WalletTransaction {
  id             String        @id @default(cuid())
  walletId       String
  type           WalletTxnType
  amount         Decimal       @db.Decimal(12, 2) // signed: +credit, -debit
  balanceAfter   Decimal       @db.Decimal(12, 2)
  reference      String? // settlementId / withdrawalId
  idempotencyKey String?       @unique // e.g. "sale:<settlementId>" — prevents double credit
  description    String?
  createdAt      DateTime      @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt(sort: Desc)])
}

enum WithdrawalStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  FAILED
}

model Withdrawal {
  id            String           @id @default(cuid())
  userId        String
  amount        Decimal          @db.Decimal(12, 2)
  status        WithdrawalStatus @default(REQUESTED)
  provider      String           @default("MOCK")
  externalRef   String?
  bankLast4     String // snapshot of the destination at request time
  failureReason String?
  requestedAt   DateTime         @default(now())
  completedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, requestedAt(sort: Desc)])
}

// ── Auction Reports ──────────────────────────────────────────────────────
// Users can report suspicious or fraudulent auctions. Admins review and
// resolve reports from the admin panel.

enum ReportReason {
  FRAUD
  COUNTERFEIT
  MISLEADING_DESCRIPTION
  WRONG_IMAGES
  PROHIBITED_ITEM
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
  ACTION_TAKEN
}

model AuctionReport {
  id         String       @id @default(cuid())
  auctionId  String
  reporterId String
  reason     ReportReason
  details    String       @db.Text
  status     ReportStatus @default(PENDING)
  adminNote  String?      @db.Text
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  auction  Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  reporter User    @relation("UserReports", fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([auctionId, reporterId])
  @@index([status])
  @@index([auctionId])
  @@index([reporterId])
}

// ---------------------------------------------------------------------------
// Auction Q&A / Inquiries — buyers ask public questions, sellers answer.
// ---------------------------------------------------------------------------

model AuctionInquiry {
  id         String    @id @default(cuid())
  auctionId  String
  askerId    String
  question   String    @db.VarChar(500)
  answer     String?   @db.VarChar(1000)
  answeredAt DateTime?
  imageUrl   String?
  isPinned   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  asker   User    @relation(fields: [askerId], references: [id], onDelete: Cascade)

  @@index([auctionId, createdAt])
  @@index([askerId])
}

// ── Wallet Deposit Orders ────────────────────────────────────────────────
// Tracks pending Razorpay orders created for wallet top-ups. This is the
// server-side record that lets the Razorpay webhook credit the wallet even
// when the frontend verify call fails (e.g. auth token expired while the
// user was in the Razorpay modal).

enum DepositOrderStatus {
  PENDING
  COMPLETED
  FAILED
}

model WalletDepositOrder {
  id              String             @id @default(cuid())
  userId          String
  razorpayOrderId String             @unique
  amount          Decimal            @db.Decimal(12, 2)
  status          DepositOrderStatus @default(PENDING)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([razorpayOrderId])
}

// ── Settlement Disputes (Escrow authenticity challenges) ─────────────────
// When a buyer receives an item and suspects it's counterfeit or not as
// described, they open a dispute with proof. The admin reviews and either
// refunds the buyer (100%) or releases funds to the seller (90% + 10% platform).

enum DisputeReason {
  COUNTERFEIT
  NOT_AS_DESCRIBED
  DAMAGED
  WRONG_ITEM
  NOT_DELIVERED
}

enum DisputeStatus {
  OPEN
  RESOLVED_REFUND    // Admin ruled in buyer's favour → 100% refund
  RESOLVED_REJECTED  // Admin dismissed → funds released to seller
}

model SettlementDispute {
  id           String        @id @default(cuid())
  settlementId String        @unique
  buyerId      String
  reason       DisputeReason
  description  String        @db.Text
  proofUrls    String[]      // Uploaded photos/videos of flaws, tags, packaging
  status       DisputeStatus @default(OPEN)
  adminNotes   String?       @db.Text
  resolvedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  settlement AuctionSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  buyer      User              @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([buyerId])
}

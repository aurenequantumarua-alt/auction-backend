# --- Server Configuration ---
NODE_ENV=production
PORT=10000
HOST=0.0.0.0

# Comma-separated list of allowed CORS origins (frontend URL on Vercel)
CORS_ORIGINS=https://auction-frontend-five-rose.vercel.app

# --- Database (PostgreSQL / Neon) ---
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require

# --- Redis (Render Key Value instance or Upstash) ---
# Example: redis://red-d9jgblv41pts73ckphp0:6379 or external rediss://...
REDIS_URL=redis://localhost:6379

# --- Auth Secrets (Generate with `openssl rand -hex 32`) ---
JWT_ACCESS_SECRET=your_32_byte_hex_jwt_access_secret_here
JWT_REFRESH_SECRET=your_32_byte_hex_jwt_refresh_secret_here
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
COOKIE_SECURE=true

# --- Payments (Razorpay) ---
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=

# --- Platform Economics ---
PLATFORM_COMMISSION_BPS=1000
WITHDRAWAL_MIN=100
PAYOUT_PROVIDER=mock
# Optional: 64-hex-char encryption key
# BANK_ENCRYPTION_KEY=

# --- Verification & Notifications ---
SMS_PROVIDER=mock
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
RESEND_API_KEY=your_resend_api_key
FIREBASE_API_KEY=your_firebase_api_key

# --- Auction Settings ---
PAYMENT_WINDOW_HOURS=24
ANTI_SNIPE_WINDOW_SECONDS=30
ANTI_SNIPE_EXTEND_SECONDS=30

# --- Storage ---
STORAGE_DRIVER=local
UPLOADS_DIR=./uploads
PUBLIC_UPLOADS_BASE_URL=/uploads

# --- Server ---
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:5173

# --- Database ---
DATABASE_URL=postgresql://aurene:aurene_dev_password@localhost:5434/aurene?schema=public

# --- Redis (BullMQ + Socket.IO adapter readiness) ---
REDIS_URL=redis://localhost:6380

# --- Auth ---
# Generate strong secrets for production: `openssl rand -hex 64`
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string_at_least_32_chars
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_string_at_least_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# --- Payments (Razorpay) ---
# PAYMENT_PROVIDER: "mock" (default; dev "Simulate paid" flow) or "razorpay".
# Leave as mock until you paste TEST-mode keys, then switch to razorpay.
# The app boots fine without keys; if provider=razorpay but keys are missing it
# falls back to mock at runtime.
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Webhook URL to configure in the Razorpay dashboard (events: payment.captured,
# order.paid): https://<your-host>/api/v1/webhooks/razorpay

# --- Platform economics + payouts ---
# Commission the platform keeps per sale (basis points; 1000 = 10%).
PLATFORM_COMMISSION_BPS=1000
# Minimum wallet withdrawal, in rupees.
WITHDRAWAL_MIN=100
# "mock" settles withdrawals instantly (dev); "razorpayx" uses RazorpayX Payouts.
PAYOUT_PROVIDER=mock
# Optional 64-hex-char key to encrypt stored bank numbers (else derived from JWT secret).
BANK_ENCRYPTION_KEY=

# --- Phone OTP / SMS (for linking a UPI/phone payout method) ---
# "mock" = no real SMS; in dev the code is returned so you can test. Set
# msg91/twilio + SMS_API_KEY to send real texts.
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=AURENE
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5

# --- Auction settings ---
# How long a winner has to pay before the next bidder is promoted.
PAYMENT_WINDOW_HOURS=24
# Last-N-seconds bid extends the auction by ANTI_SNIPE_SECONDS.
ANTI_SNIPE_WINDOW_SECONDS=30
ANTI_SNIPE_EXTEND_SECONDS=30

# --- Uploads ---
# "local" stores under backend/uploads. "s3" requires the S3_* vars below.
STORAGE_DRIVER=local
UPLOADS_DIR=./uploads
PUBLIC_UPLOADS_BASE_URL=http://localhost:4000/uploads

# S3 (only used when STORAGE_DRIVER=s3 — implementation not included in MVP)
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Rate limits ---
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_BID_MAX=30
RATE_LIMIT_BID_WINDOW_MS=60000
